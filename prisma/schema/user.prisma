

/**
 * ---------------------------- User declarations ---------------------------
 */

enum Gender_Enum {
  MALE
  FEMALE
  NONE
}

model user_Ety {
  id         String       @id @default(uuid())
  name       String
  last_name  String
  gender     Gender_Enum? @default(NONE)
  phone      String?
  updated_at DateTime     @updatedAt @db.Timestamptz(3)

  auth auth_Ety?

  notifications notifications_Ety[]

  ia_conversations ia_conversation_Ety[]

  @@map("lxia_user")
}

